---
const route = Astro.locals.starlightRoute;
const { id } = route.entry;

const labels: Record<string, string> = {
	"getting-started": "Guide",
	protocol: "Protocol",
	limits: "Protocol",
	development: "Contribute",
};
const label =
	id === "api" || id.startsWith("api/")
		? "API reference"
		: (labels[id] ?? "Reference");
---

<div class="manual-page-title not-content">
	<p>{label}</p>
	<h1 id="_top">{route.entry.data.title}</h1>
</div>

<style>
	.manual-page-title {
		padding-top: clamp(2rem, 5vw, 4.5rem);
	}

	p {
		margin: 0 0 0.9rem;
		font-family: var(--gc-font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		color: var(--gc-muted);
		text-transform: uppercase;
		letter-spacing: 0.09em;
	}

	h1 {
		max-width: 18ch;
		margin: 0;
		font-family: var(--gc-font-serif);
		font-size: var(--sl-text-h1);
		font-weight: 600;
		line-height: 1;
		color: var(--gc-ink);
		letter-spacing: -0.035em;
		overflow-wrap: anywhere;
	}
</style>
