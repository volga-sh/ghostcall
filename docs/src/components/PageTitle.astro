---
const route = Astro.locals.starlightRoute;
const id = route.entry.id;

const labels: Record<string, string> = {
	"getting-started": "Guide",
	examples: "Guide",
	protocol: "Protocol",
	limits: "Protocol",
	development: "Contribute",
};
// biome-ignore lint/correctness/noUnusedVariables: Referenced by the Astro template.
const label =
	id === "api" || id.startsWith("api/")
		? "API reference"
		: (labels[id] ?? "Reference");
const isIdentifier = id.startsWith("api/") && id !== "api/types";
// Wrap identifiers at camel-case boundaries without changing their text or copy value.
// biome-ignore lint/correctness/noUnusedVariables: Referenced by the Astro template.
const titleParts = isIdentifier
	? route.entry.data.title.split(/(?=[A-Z])/)
	: [route.entry.data.title];
---

<div class="page-title not-content">
	<p>{label}</p>
	<h1 id="_top" class:list={{ "api-title": isIdentifier }}>{titleParts.map((part, index) => <>{index > 0 && <wbr />}{part}</>)}</h1>
</div>

<style>
	.page-title {
		padding-top: 1rem;
	}

	p {
		margin: 0 0 0.75rem;
		color: var(--gc-muted);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	h1 {
		margin: 0;
		color: var(--gc-ink);
		font-family: var(--gc-font-sans);
		font-size: var(--sl-text-h1);
		font-weight: 600;
		letter-spacing: -0.04em;
		line-height: 1.2;
		overflow-wrap: anywhere;
	}

	.api-title {
		font-family: var(--gc-font-mono);
		font-size: clamp(1.375rem, 2.5vw, 2rem);
		font-weight: 500;
		letter-spacing: -0.04em;
	}
</style>
