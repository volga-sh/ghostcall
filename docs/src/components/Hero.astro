---
const { hero } = Astro.locals.starlightRoute.entry.data;
---

{hero && (
	<section aria-labelledby="_top" class="manual-abstract">
		<div aria-hidden="true" class="manual-abstract-label">
			<span>§00</span>
			<span>Abstract</span>
		</div>
		<div class="manual-abstract-body">
			<h1 id="_top">{hero.title}</h1>
			{hero.tagline && <p>{hero.tagline}</p>}
		</div>
	</section>
)}

<style>
	.manual-abstract {
		display: grid;
		grid-template-columns: var(--gc-label-column) minmax(0, 1fr);
		gap: var(--gc-column-gap);
		padding-block: 2.5rem 1.5rem;
	}

	.manual-abstract-label {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		/* Sits the label's cap-line on the first cap-line of the title. */
		padding-top: 0.15rem;
		font-family: var(--gc-font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--gc-muted);
		text-transform: uppercase;
		letter-spacing: 0.09em;
	}

	.manual-abstract-body {
		min-width: 0;
	}

	h1 {
		margin: 0;
		font-family: var(--gc-font-serif);
		font-size: 3.5rem;
		font-weight: 600;
		line-height: 1.02;
		color: var(--gc-ink);
		letter-spacing: -0.03em;
		@supports (text-wrap: balance) {
			text-wrap: balance;
		}
	}

	p {
		margin: 1.15rem 0 0;
		font-family: var(--gc-font-serif);
		font-size: 1.15rem;
		line-height: 1.55;
		color: var(--gc-ink);
	}

	@media screen and (max-width: 47.99rem) {
		.manual-abstract {
			grid-template-columns: minmax(0, 1fr);
			gap: 1rem;
		}

		.manual-abstract-label {
			flex-direction: row;
			gap: 0.75rem;
			padding-top: 0;
		}

		h1 {
			font-size: 2.4rem;
		}
	}
</style>
