---
import Search from "virtual:starlight/components/Search";

const repository = "https://github.com/volga-sh/ghostcall";
---

<div class="manual-header">
	<a class="manual-brand" href="/">ghostcall</a>

	<nav aria-label="Primary" class="manual-nav">
		<a href="/#install">Install</a>
		<a class="manual-nav-optional" href="/getting-started/">Guide</a>
		<a href="/api/">API</a>
		<a class="manual-nav-optional" href="/protocol/">Protocol</a>
		<a href={repository}>Source</a>
	</nav>

	<div class="manual-search">
		<Search />
	</div>
</div>

<style>
	.manual-header {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		gap: clamp(1rem, 3vw, 3rem);
		align-items: center;
		width: 100%;
		height: 100%;
	}

	/* The landing-page masthead follows the same centred measure as its content. */
	:global([data-has-hero]) .manual-header {
		max-width: var(--gc-sheet);
		margin-inline: auto;
	}

	.manual-brand {
		font-family: var(--gc-font-serif);
		font-size: 1.75rem;
		font-weight: 700;
		line-height: 1;
		color: var(--gc-ink);
		letter-spacing: -0.035em;
		white-space: nowrap;
		text-decoration: none;
	}

	.manual-nav {
		display: flex;
		gap: clamp(0.8rem, 1.8vw, 1.7rem);
		align-items: center;
		justify-content: flex-end;
		min-width: 0;
		font-family: var(--gc-font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		white-space: nowrap;
	}

	.manual-nav a {
		color: var(--gc-muted);
		text-decoration: none;
	}

	.manual-nav a:hover,
	.manual-nav a:focus-visible {
		color: var(--gc-accent);
	}

	.manual-search {
		display: flex;
		justify-content: flex-end;
		min-width: 2.5rem;
	}

	@media (max-width: 68rem) {
		.manual-nav-optional {
			display: none;
		}
	}

	@media (max-width: 49.99rem) {
		.manual-header {
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.75rem;
		}

		.manual-nav {
			display: none;
		}

		.manual-brand {
			font-size: 1.55rem;
		}
	}
</style>
