---
// biome-ignore lint/correctness/noUnusedVariables: Referenced by the Astro template.
const entries = [
	{
		name: "aggregateDecodedCalls()",
		href: "/api/aggregate-decoded-calls/",
		description: "Decoded values in call order.",
	},
	{
		name: "aggregateCalls()",
		href: "/api/aggregate-calls/",
		description: "Success flags and return data in call order.",
	},
	{
		name: "encodeCalls()",
		href: "/api/encode-calls/",
		description: "Request data for a manual eth_call.",
	},
	{
		name: "decodeResults()",
		href: "/api/decode-results/",
		description: "Entries parsed from a raw response.",
	},
];
---

<nav class="api-index not-content" aria-label="ghostcall functions">
	<div class="api-index-header" aria-hidden="true">
		<span>Function</span>
		<span>Result</span>
	</div>
	<ul>
		{
			entries.map((entry) => (
				<li>
					<a class="api-index-row" href={entry.href}>
						<code>{entry.name}</code>
						<span>{entry.description}</span>
						<i aria-hidden="true">→</i>
					</a>
				</li>
			))
		}
	</ul>
</nav>

<style>
	.api-index {
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--gc-rule);
		border-radius: var(--gc-radius);
		background: var(--gc-surface);
	}

	.api-index ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.api-index li {
		margin: 0;
	}

	.api-index-header,
	.api-index-row {
		display: grid;
		grid-template-columns: minmax(15rem, 0.9fr) minmax(0, 1.1fr) 1.25rem;
		gap: 1.25rem;
		align-items: baseline;
	}

	.api-index-header {
		padding: 0.7rem 1rem;
		background: var(--gc-code);
		color: var(--gc-muted);
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.api-index-row {
		position: relative;
		border-bottom: 1px solid var(--gc-rule);
		padding: 1.05rem 1rem;
		color: var(--gc-muted);
		text-decoration: none;
		transition:
			background-color 120ms ease,
			color 120ms ease;
	}

	.api-index li:last-child .api-index-row {
		border-bottom: 0;
	}

	.api-index-row::before {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		width: 3px;
		background: transparent;
		content: "";
	}

	.api-index-row code {
		border: 0;
		padding: 0;
		background: transparent;
		color: var(--gc-accent);
		font-family: var(--gc-font-mono);
		font-size: 0.8125rem;
		font-weight: 500;
	}

	.api-index-row > span {
		font-size: 0.9375rem;
		line-height: 1.4;
	}

	.api-index-row i {
		color: var(--gc-muted);
		font-family: var(--gc-font-mono);
		font-size: 0.8rem;
		font-style: normal;
	}

	.api-index-row:is(:hover, :focus-visible) {
		background: var(--gc-accent-soft);
	}

	.api-index-row:is(:hover, :focus-visible)::before {
		background: var(--gc-accent);
	}

	.api-index-row:is(:hover, :focus-visible) :is(code, i) {
		color: var(--gc-accent-deep);
	}

	@media (max-width: 42rem) {
		.api-index-header {
			display: none;
		}

		.api-index-row {
			grid-template-columns: minmax(0, 1fr);
			gap: 0.45rem;
			padding-inline-end: 2.5rem;
		}

		.api-index-row i {
			position: absolute;
			inset-block-start: 1.1rem;
			inset-inline-end: 1rem;
		}
	}
</style>
