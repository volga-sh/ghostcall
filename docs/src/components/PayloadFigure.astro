---
type Props = {
	kind: "request" | "response";
};

// biome-ignore lint/correctness/noUnusedVariables: Referenced by the Astro template.
const { kind } = Astro.props;
---

<figure class="payload-figure not-content">
	{
		kind === "request" ? (
			<div class="byte-layout" role="img" aria-label="Request layout: 91-byte ghostcall initcode followed by repeated calldata length, target address, and calldata fields.">
				<span class="field field-program">91-byte program</span>
				<span class="field">length · 2</span>
				<span class="field">target · 20</span>
				<span class="field">calldata · N</span>
				<span class="field field-repeat">…</span>
			</div>
		) : (
			<div class="byte-layout" role="img" aria-label="Response layout: repeated packed success and return-data length header followed by return data.">
				<span class="field field-program">success + length · 2</span>
				<span class="field">return data · N</span>
				<span class="field field-repeat">…</span>
			</div>
		)
	}
	<figcaption>{kind === "request" ? "Request" : "Response"} layout. Field sizes are in bytes; entries repeat in call order.</figcaption>
</figure>

<style>
	.payload-figure {
		margin: 1.5rem 0;
	}

	.byte-layout {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.field {
		display: flex;
		flex: 1 1 5rem;
		align-items: center;
		justify-content: center;
		border: 1px solid var(--gc-rule);
		border-radius: 0.375rem;
		padding: 0.875rem 0.625rem;
		background: var(--gc-surface);
		color: var(--gc-muted);
		font-family: var(--gc-font-mono);
		font-size: 0.75rem;
		line-height: 1.5;
		text-align: center;
	}

	.field-program {
		flex-grow: 1.5;
		background: var(--gc-accent-soft);
		color: var(--gc-accent-deep);
	}

	.field-repeat {
		flex: 0 0 2.5rem;
	}

	figcaption {
		margin-top: 0.75rem;
		color: var(--gc-muted);
		font-size: 0.8125rem;
	}
</style>
